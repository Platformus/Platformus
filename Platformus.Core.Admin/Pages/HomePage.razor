@page "/"
@using Platformus.Core.Admin.HomePageWidgets
@inject IStringLocalizer<Resources.Core> Localizer

<PageTitle>@Localizer["Home"]</PageTitle>

<Heading Text="@Localizer["Home"]" />
@if (Widgets != null)
{
  foreach (IHomePageWidget widget in Widgets)
  {
    <DynamicComponent Type="widget.Type" />
  }
}

@code {
  private IEnumerable<IHomePageWidget>? Widgets { get; set; }

  protected override void OnInitialized()
  {
    this.Widgets = AppDomain.CurrentDomain.GetAssemblies()
      .SelectMany(assembly => assembly.GetTypes())
      .Where(t => typeof(IHomePageWidget).IsAssignableFrom(t) && t.IsClass && !t.IsAbstract)
      .Select(t => (Activator.CreateInstance(t) as IHomePageWidget)!)
      .OrderBy(w => w.Position)
      .ToList();
  }
}