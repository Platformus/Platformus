@attribute [Authorize]
@page "/users/{userId:int}/credentials/create"
@page "/users/{userId:int}/credentials/{id:int}/edit"
@inject HttpClient HttpClient
@inject IApiClient1K<int, User, UserFilter> UserApiClient
@inject IApiClient1K<int, Credential, CredentialFilter> CredentialApiClient
@inject IApiClient1K<int, CredentialType, CredentialTypeFilter> CredentialTypeApiClient
@inject NavigationManager NavigationManager
@inject IStringLocalizer<Resources.Core> Localizer

<PageTitle>@(Id == null ? Localizer["Credentials.CreatingCredential"] : Localizer["Credentials.EditingCredential"])</PageTitle>

<Breadcrumb Items="BreadcrumbItems" />
<Heading Text="@(Id == null ? Localizer["Credentials.CreatingCredential"] : Localizer["Credentials.EditingCredential"])" />
<div class="row">
  <div class="col-md-5">
    <EditForm Model="Credential" OnValidSubmit="OnSubmit">
      <FluentValidationValidator />
      <SelectField DisplayName="@Localizer["Credentials.CredentialType"]" @bind-Value="CredentialTypeId">
        @if (CredentialTypes != null)
        {
          foreach (var credentialType in CredentialTypes)
          {
            <option value="@credentialType.Id">@Localizer[credentialType.Name!]</option>
          }
        }
      </SelectField>
      <TextField DisplayName="@Localizer["Credentials.Identifier"]" @bind-Value="Credential.Identifier" />
      @if (CredentialTypeId == Domain.Models.CredentialTypes.EmailAndPassword)
      {
        <SecretField DisplayName="@Localizer["Credentials.Password"]" @bind-Value="Credential.Secret" />
      }
      <div class="d-flex gap-3">
        <Button Color="ButtonColor.Primary" Type="ButtonType.Submit">@Localizer["Save"]</Button>
        <Button Color="ButtonColor.Primary" Outline="true" Type="ButtonType.Link" To="@($"/users/{@UserId}{(this.Id == null ? null : $"/credentials/{Id}")}")">@Localizer["Cancel"]</Button>
      </div>
    </EditForm>
  </div>
</div>

@code {
  [Parameter] public int UserId { get; set; }
  [Parameter] public int? Id { get; set; }

  private User? User { get; set; }
  private Credential Credential { get; set; } = new();
  private string? CredentialTypeId
  {
    get => this.Credential.CredentialType?.Id;

    set
    {
      if (string.IsNullOrEmpty(value))
        this.Credential.CredentialType = null;

      else this.Credential.CredentialType = this.CredentialTypes?.FirstOrDefault(ct => ct.Id == value);
    }
  }

  private IEnumerable<CredentialType>? CredentialTypes { get; set; }
  private List<BreadcrumbItem> BreadcrumbItems { get; set; } = [];

  protected override async Task OnInitializedAsync()
  {
    this.CredentialApiClient = new ApiClient1K<int, Credential, CredentialFilter>(this.HttpClient, "/api/v1/credentials"); // TODO: make it in a normal way
    this.User = await this.UserApiClient.GetByIdAsync(this.UserId);

    if (this.Id != null)
    {
      Credential? credential = await this.CredentialApiClient.GetByIdAsync((int)this.Id);

      if (credential != null) this.Credential = credential;
    }

    else this.Credential.User = new User { Id = this.UserId };

    this.CredentialTypes = await this.CredentialTypeApiClient.GetAllAsync();
    this.BreadcrumbItems =
    [
      new BreadcrumbItem{ Href = "/users", Text = this.Localizer["Users"] },
      new BreadcrumbItem{ Href = $"/users/{@UserId}", Text = this.User!.Name }
    ];
  }

  private async Task OnSubmit()
  {
    if (this.Id == null)
      this.Id = (await this.CredentialApiClient.PostAsync(this.Credential))?.Id;
    
    else await this.CredentialApiClient.PutAsync(this.Credential);

    this.NavigationManager.NavigateTo($"/users/{this.UserId}/credentials/{this.Id}");
  }
}