@attribute [Authorize]
@page "/users/{userId:int}/credentials/{id:int}"
@inject HttpClient HttpClient
@inject IApiClient1K<int, Credential, CredentialFilter> CredentialApiClient
@inject NavigationManager NavigationManager
@inject IStringLocalizer<Resources.Core> Localizer

<PageTitle>@Credential?.Identifier</PageTitle>

<Breadcrumb Items="BreadcrumbItems" />
<Heading Text="@Credential?.Identifier">
  <ContextActions>
    <Button Color="ButtonColor.Primary" Outline="true" Type="ButtonType.Link" To="@($"/users/{UserId}/credentials/{Id}/edit")">
      <Icon Name="IconName.PencilFill"></Icon>
      @Localizer["Edit"]
    </Button>
    <Button Color="ButtonColor.Danger" Outline="true" @onclick="OnDeleteButtonClick">
      <Icon Name="IconName.Trash3"></Icon>
      @Localizer["Delete"]
    </Button>
  </ContextActions>
</Heading>
@if (this.Credential != null)
{
  <dl>
    <dt>
      @Localizer["Credentials.CredentialType"]
    </dt>
    <dd>
      @Localizer[Credential.CredentialType!.Name]
    </dd>
    <dt>
      @Localizer["Credentials.Identifier"]
    </dt>
    <dd>
      @Credential.Identifier
    </dd>
  </dl>
}

<ConfirmDialog @ref="Dialog" />

@code {
  [Parameter] public int UserId { get; set; }
  [Parameter] public int Id { get; set; }

  private Credential? Credential { get; set; }
  private List<BreadcrumbItem> BreadcrumbItems { get; set; } = [];
  private ConfirmDialog Dialog { get; set; } = default!;

  protected override async Task OnInitializedAsync()
  {
    this.CredentialApiClient = new ApiClient1K<int, Credential, CredentialFilter>(this.HttpClient, "/api/v1/credentials"); // TODO: make it in a normal way
    this.Credential = await this.CredentialApiClient.GetByIdAsync(
      this.Id,
      [
        new Inclusion<Credential>(c => c.User),
        new Inclusion<Credential>(c => c.CredentialType)
      ]
    );

    this.BreadcrumbItems =
    [
      new BreadcrumbItem{ Href = "/users", Text = this.Localizer["Users"] },
      new BreadcrumbItem{ Href = $"/users/{@UserId}", Text = this.Credential!.User!.Name }
    ];
  }

  private async Task OnDeleteButtonClick()
  {
    if (await this.Dialog.ShowDeleteConfirmationAsync(this.Localizer))
      if (await this.CredentialApiClient.DeleteAsync(this.Id))
        this.NavigationManager.NavigateTo($"/users/{this.UserId}");
  }
}