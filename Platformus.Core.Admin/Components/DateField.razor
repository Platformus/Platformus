@inherits InputDate<DateTime?>

<div class="mb-3">
  @if (!string.IsNullOrWhiteSpace(DisplayName ?? ValueExpression!.GetDisplayName()))
  {
    <label class="form-label">@(DisplayName ?? ValueExpression!.GetDisplayName())</label>
  }
  <input class="@CssClass form-control" type="date" @bind="@CurrentValue" @attributes="AdditionalAttributes" />
  @if (this.ValueExpression != null)
  {
    <ValidationMessage class="text-danger" For=@ValueExpression />
  }
</div>