@inject IUrl Url
@inject IStringLocalizer<Resources.Core> Localizer
@implements IFilterField

<div class="col-auto">
  <div class="row g-2 align-items-center">
    <div class="col-auto">
      <label class="col-form-label col-form-label-sm">@Label</label>
    </div>
    <div class="col-auto">
      <select class="form-select form-select-sm" @bind="Value">
        <option></option>
        @ChildContent
      </select>
    </div>
  </div>
</div>

@code {
  [CascadingParameter(Name = "Parent")] public Filter Parent { get; set; } = default!;
  [Parameter, EditorRequired] public string Label { get; set; } = string.Empty;
  [Parameter, EditorRequired] public string FilteringPropertyPath { get; set; } = string.Empty;
  [Parameter, EditorRequired] public RenderFragment? ChildContent { get; set; }

  private string? Value { get; set; }

  public IReadOnlyDictionary<string, string?> GetValues()
  {
    return new Dictionary<string, string?>
    {
      { $"{this.FilteringPropertyPath}.equals", this.Value }
    };
  }

  public void Reset()
  {
    this.Value = null;
    this.StateHasChanged();
  }

  protected override void OnInitialized()
  {
    this.Parent?.AddFilterField(this);
    base.OnInitialized();
  }
}