<CascadingAuthenticationState>
  <Router AppAssembly="@typeof(App).Assembly" AdditionalAssemblies="@AdditionalAssemblies">
    <Found Context="routeData">
      <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
        <NotAuthorized>
          <LoginPage />
        </NotAuthorized>
      </AuthorizeRouteView>
      <FocusOnNavigate RouteData="@routeData" Selector="h1" />
    </Found>
    <NotFound>
      <PageTitle>Not found</PageTitle>
      <LayoutView Layout="@typeof(MainLayout)">
        <p role="alert">Sorry, there's nothing at this address.</p>
      </LayoutView>
    </NotFound>
  </Router>
</CascadingAuthenticationState>

@code {
  private IEnumerable<Assembly>? AdditionalAssemblies { get; set; }

  protected override void OnInitialized()
  {
    IEnumerable<Type> metadatas = AppDomain.CurrentDomain.GetAssemblies()
      .SelectMany(assembly => assembly.GetTypes())
      .Where(t => typeof(IMetadata).IsAssignableFrom(t) && t.IsClass && !t.IsAbstract)
      .ToList();

    this.AdditionalAssemblies = metadatas.Select(t => t.Assembly).ToList();
  }
}