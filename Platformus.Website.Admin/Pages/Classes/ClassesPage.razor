@inherits ListPageBase<int, Class, ClassFilter>
@attribute [Authorize]
@page "/classes"
@inject IStringLocalizer<Resources.Website> WebsiteLocalizer

<PageTitle>@WebsiteLocalizer["Classes"]</PageTitle>

<Heading Text="@WebsiteLocalizer["Classes"]">
  <ContextActions>
    <Button Color="ButtonColor.Primary" Outline="true" Type="ButtonType.Link" To="/classes/create">
      <Icon Name="IconName.Plus"></Icon>
      @WebsiteLocalizer["Classes.CreateClass"]
    </Button>
  </ContextActions>
</Heading>
<Filter>
  <TextFilter Label="@WebsiteLocalizer["Classes.SingularName"]" FilteringPropertyPath="singularname" />
  <TextFilter Label="@WebsiteLocalizer["Classes.PluralName"]" FilteringPropertyPath="pluralname" />
  <TextFilter Label="@WebsiteLocalizer["Classes.UrlSegment"]" FilteringPropertyPath="urlsegment" />
</Filter>
<Table TItem="Class" Items="Classes" RowClicked="OnRowClick">
  <TableColumns>
    <TableColumn Title="@WebsiteLocalizer["Classes.SingularName"]" SortingPropertyPath="name">
      <CellTemplate>
        @context.SingularName
      </CellTemplate>
    </TableColumn>
    <TableColumn Title="@WebsiteLocalizer["Classes.PluralName"]" SortingPropertyPath="name">
      <CellTemplate>
        @context.PluralName
      </CellTemplate>
    </TableColumn>
    <TableColumn Title="@WebsiteLocalizer["Classes.UrlSegment"]" SortingPropertyPath="name">
      <CellTemplate>
        @context.UrlSegment
      </CellTemplate>
    </TableColumn>
  </TableColumns>
</Table>

<ConfirmDialog @ref="Dialog" />

@code {
  private IPagedEnumerable<Class>? Classes { get; set; }
  private ConfirmDialog Dialog { get; set; } = default!;

  protected override async Task LoadAsync()
  {
    this.Classes = await this.ApiClient.GetAllAsync(this.FilterMapper.Map<ClassFilter>(), this.Sorting, this.Offset, this.Limit);
  }

  private void OnRowClick(Class @class)
  {
    this.NavigationManager.NavigateTo($"/classes/{@class.Id}");
  }

  private async Task OnDeleteButtonClick(Class @class)
  {
    if (await this.Dialog.ShowDeleteConfirmationAsync(this.CoreLocalizer))
      if (await this.ApiClient.DeleteAsync(@class.Id))
        await this.LoadAsync();
  }
}